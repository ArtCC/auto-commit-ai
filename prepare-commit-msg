#!/usr/bin/env xcrun swift

import Foundation

// MARK: - Configuration

let environment = ProcessInfo.processInfo.environment

let model = environment["AUTO_COMMIT_AI_MODEL"] ?? "gpt-5.4-mini"
let timeoutSeconds = TimeInterval(environment["AUTO_COMMIT_AI_TIMEOUT"] ?? "30") ?? 30
let maxDiffCharacters = Int(environment["AUTO_COMMIT_AI_MAX_DIFF_CHARS"] ?? "60000") ?? 60000
let maxTokens = Int(environment["AUTO_COMMIT_AI_MAX_TOKENS"] ?? "1200") ?? 1200
let fallbackMessage = environment["AUTO_COMMIT_AI_FALLBACK_MESSAGE"] ?? "Update changes"
let shouldLogDiff = ["1", "true", "yes"].contains((environment["AUTO_COMMIT_AI_LOG_DIFF"] ?? "").lowercased())
let keychainService = environment["AUTO_COMMIT_AI_KEYCHAIN_SERVICE"] ?? "auto-commit-ai-openai-api-key"

let args = CommandLine.arguments
let scriptPath = URL(fileURLWithPath: args.first ?? "prepare-commit-msg")
let hookDirectory = scriptPath.deletingLastPathComponent()
let logURL = hookDirectory.appendingPathComponent("prepare-commit-msg.log")

// MARK: - Logging

func log(_ message: String) {
    let timestamp = ISO8601DateFormatter().string(from: Date())
    guard let data = "[\(timestamp)] \(message)\n".data(using: .utf8) else { return }

    if FileManager.default.fileExists(atPath: logURL.path),
       let handle = try? FileHandle(forWritingTo: logURL) {
        handle.seekToEndOfFile()
        handle.write(data)
        try? handle.close()
    } else {
        try? data.write(to: logURL, options: .atomic)
    }
}

func warnAndContinue(_ message: String) -> Never {
    log(message)
    fputs("auto-commit-ai: \(message)\n", stderr)
    exit(0)
}

func hasUserVisibleCommitContent(_ message: String) -> Bool {
    message
        .components(separatedBy: .newlines)
        .contains { line in
            let trimmedLine = line.trimmingCharacters(in: .whitespacesAndNewlines)
            return !trimmedLine.isEmpty && !trimmedLine.hasPrefix("#")
        }
}

func warnAndUseFallback(_ message: String, commitMessagePath: String) -> Never {
    log(message)
    fputs("auto-commit-ai: \(message); using fallback commit message\n", stderr)

    do {
        let originalMessage = try String(contentsOfFile: commitMessagePath, encoding: .utf8)
        if hasUserVisibleCommitContent(originalMessage) {
            log("Fallback skipped because commit message already has content.")
            exit(0)
        }

        let fallback = fallbackMessage.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !fallback.isEmpty else {
            log("Fallback skipped because AUTO_COMMIT_AI_FALLBACK_MESSAGE is empty.")
            exit(0)
        }

        let newMessage = fallback + "\n\n" + originalMessage
        try newMessage.write(toFile: commitMessagePath, atomically: true, encoding: .utf8)
        log("Fallback commit message written successfully.")
        exit(0)
    } catch {
        log("Failed to write fallback commit message: \(error.localizedDescription)")
        exit(0)
    }
}

// MARK: - Shell Helpers

@discardableResult
func shell(_ arguments: [String], logOutput: Bool = false) -> (output: String, status: Int32) {
    let task = Process()
    task.executableURL = URL(fileURLWithPath: "/usr/bin/env")
    task.arguments = arguments

    let pipe = Pipe()
    task.standardOutput = pipe
    task.standardError = pipe

    do {
        try task.run()
    } catch {
        log("Failed to run command '\(arguments.joined(separator: " "))': \(error.localizedDescription)")
        return ("", 1)
    }

    let data = pipe.fileHandleForReading.readDataToEndOfFile()
    task.waitUntilExit()

    let output = String(decoding: data, as: UTF8.self)
    let outputInfo = logOutput ? "; output prefix: \(output.prefix(200))" : ""
    log("Command '\(arguments.joined(separator: " "))' finished with status \(task.terminationStatus)\(outputInfo)")

    return (output, task.terminationStatus)
}

func keychainAPIKey() -> String? {
    let result = shell([
        "security", "find-generic-password",
        "-a", NSUserName(),
        "-s", keychainService,
        "-w"
    ])

    guard result.status == 0 else { return nil }

    let key = result.output.trimmingCharacters(in: .whitespacesAndNewlines)
    return key.isEmpty ? nil : key
}

func openAIAPIKey() -> String? {
    if let key = environment["OPENAI_API_KEY"]?.trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty {
        return key
    }

    return keychainAPIKey()
}

// MARK: - Git Hook Inputs

log("Hook started with \(max(args.count - 1, 0)) argument(s).")

guard args.count >= 2 else {
    warnAndContinue("missing commit message path")
}

let commitMessagePath = args[1]
let commitSource = args.count > 2 ? args[2] : ""

// Respect commits where Git already has a message or is preserving existing history.
// Do not skip "template": Git uses it before the editor opens, so the hook can still
// generate a useful message above the template content.
let skippedSources: Set<String> = ["message", "merge", "squash", "commit"]
if skippedSources.contains(commitSource) {
    log("Skipping commit source '\(commitSource)'.")
    exit(0)
}

// MARK: - Diff Collection

let diffResult = shell(["git", "diff", "--cached", "--no-ext-diff"])
guard diffResult.status == 0 else {
    warnAndContinue("could not read staged diff")
}

let diff = diffResult.output.trimmingCharacters(in: .whitespacesAndNewlines)
guard !diff.isEmpty else {
    log("No staged changes found.")
    exit(0)
}

let diffForPrompt: String
if diff.count > maxDiffCharacters {
    let endIndex = diff.index(diff.startIndex, offsetBy: maxDiffCharacters)
    diffForPrompt = String(diff[..<endIndex]) + "\n\n[Diff truncated at \(maxDiffCharacters) characters.]"
    log("Staged diff truncated from \(diff.count) to \(maxDiffCharacters) characters.")
} else {
    diffForPrompt = diff
    log("Staged diff collected with \(diff.count) characters.")
}

if shouldLogDiff {
    log("Diff logging enabled by AUTO_COMMIT_AI_LOG_DIFF. Diff prefix: \(diffForPrompt.prefix(1000))")
}

guard let apiKey = openAIAPIKey() else {
    warnAndUseFallback(
        "missing OpenAI API key; set OPENAI_API_KEY or store it in macOS Keychain service '\(keychainService)'",
        commitMessagePath: commitMessagePath
    )
}

// MARK: - OpenAI Request

struct ResponsesRequest: Codable {
    struct Reasoning: Codable {
        let effort: String
    }

    let model: String
    let instructions: String
    let input: String
    let reasoning: Reasoning
    let max_output_tokens: Int
}

struct ResponsesResponse: Codable {
    struct OutputItem: Codable {
        struct ContentItem: Codable {
            let type: String?
            let text: String?
        }

        let type: String?
        let content: [ContentItem]?
    }

    let output_text: String?
    let output: [OutputItem]?

    var textOutput: String? {
        if let outputText = output_text?.trimmingCharacters(in: .whitespacesAndNewlines), !outputText.isEmpty {
            return outputText
        }

        let text = output?
            .flatMap { $0.content ?? [] }
            .compactMap { $0.text }
            .joined(separator: "\n")
            .trimmingCharacters(in: .whitespacesAndNewlines)

        return text?.isEmpty == false ? text : nil
    }
}

struct ErrorResponse: Codable {
    struct APIError: Codable {
        let message: String
    }

    let error: APIError
}

let instructions = """
You generate concise Git commit messages from staged diffs.
Return only the commit message.
Format:
First line: imperative title, maximum 72 characters, no trailing period.
Blank line.
Bullet list: each relevant change starts with "- ".
Use factual, neutral, technical language.
Do not mention AI, prompts, advice, uncertainty, or explanations.
"""

let input = """
Generate a commit message for this staged diff:

```diff
\(diffForPrompt)
```
"""

let responsesRequest = ResponsesRequest(
    model: model,
    instructions: instructions,
    input: input,
    reasoning: .init(effort: "low"),
    max_output_tokens: maxTokens
)

guard let url = URL(string: "https://api.openai.com/v1/responses"),
      let body = try? JSONEncoder().encode(responsesRequest) else {
    warnAndUseFallback("could not create OpenAI request", commitMessagePath: commitMessagePath)
}

var request = URLRequest(url: url)
request.httpMethod = "POST"
request.timeoutInterval = timeoutSeconds
request.setValue("Bearer \(apiKey)", forHTTPHeaderField: "Authorization")
request.setValue("application/json", forHTTPHeaderField: "Content-Type")
request.httpBody = body

let semaphore = DispatchSemaphore(value: 0)
var generatedMessage: String?
var requestFailure: String?

let requestTask = URLSession.shared.dataTask(with: request) { data, response, error in
    defer { semaphore.signal() }

    if let error {
        requestFailure = error.localizedDescription
        return
    }

    guard let httpResponse = response as? HTTPURLResponse else {
        requestFailure = "missing HTTP response"
        return
    }

    guard let data else {
        requestFailure = "empty OpenAI response"
        return
    }

    guard (200..<300).contains(httpResponse.statusCode) else {
        if let apiError = try? JSONDecoder().decode(ErrorResponse.self, from: data) {
            requestFailure = "OpenAI HTTP \(httpResponse.statusCode): \(apiError.error.message)"
        } else {
            requestFailure = "OpenAI HTTP \(httpResponse.statusCode)"
        }
        return
    }

    guard let responsesResponse = try? JSONDecoder().decode(ResponsesResponse.self, from: data),
          let content = responsesResponse.textOutput,
          !content.isEmpty else {
        requestFailure = "could not parse OpenAI response"
        return
    }

    generatedMessage = content
}

log("Sending request to OpenAI with model '\(model)'.")
requestTask.resume()

if semaphore.wait(timeout: .now() + timeoutSeconds) == .timedOut {
    requestTask.cancel()
    warnAndUseFallback("OpenAI request timed out after \(Int(timeoutSeconds)) seconds", commitMessagePath: commitMessagePath)
}

if let requestFailure {
    warnAndUseFallback(requestFailure, commitMessagePath: commitMessagePath)
}

guard let generatedMessage else {
    warnAndUseFallback("OpenAI did not generate a commit message", commitMessagePath: commitMessagePath)
}

// MARK: - Commit Message Update

do {
    let originalMessage = try String(contentsOfFile: commitMessagePath, encoding: .utf8)
    let newMessage = generatedMessage + "\n\n" + originalMessage
    try newMessage.write(toFile: commitMessagePath, atomically: true, encoding: .utf8)
    log("Commit message updated successfully.")
} catch {
    log("Failed to update commit message: \(error.localizedDescription)")
    fputs("auto-commit-ai: failed to update commit message: \(error.localizedDescription)\n", stderr)
    exit(1)
}